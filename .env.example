# Local development requires no credentials. Use Node from .nvmrc.
# Deployment values are server-only; never prefix these with NEXT_PUBLIC_.
INGENIUM_WORKER_NAME=ingenium-plus-staging
INGENIUM_DB_ID=
INGENIUM_R2_BUCKET=
PUBLIC_BASE_URL=
INGENIUM_DEPLOY_CONFIG=.wrangler/ingenium.jsonc
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
ALLOW_STATIC_FALLBACK=false
PILOT_ANALYTICS_ENABLED=false
EDGE_RATE_LIMIT_READY=false
PILOT_START_DATE=
PILOT_DURATION_DAYS=42
# Set only after operational approval. Cleanup generation never executes SQL.
RETENTION_APPROVED=false
SURVEY_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
ALERT_WEBHOOK_URL=
# Scanning/extraction are unavailable; private bytes remain quarantined.
MALWARE_SCANNER_ENDPOINT=
MALWARE_SCANNER_TOKEN=
DOCUMENT_EXTRACTION_ENDPOINT=
DOCUMENT_EXTRACTION_TOKEN=
DATA_PROTECTION_CONTACT=
SECURITY_INCIDENT_CONTACT=
