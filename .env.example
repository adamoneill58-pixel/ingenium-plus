# INGENIUM+ v1.5.1 uses Cloudflare bindings rather than browser-exposed secrets.
# Provision these in the deployment control plane; never prefix privileged values with NEXT_PUBLIC_.
D1_DATABASE_BINDING=DB
R2_DOCUMENTS_BINDING=DOCUMENTS

# Optional future integrations. They are intentionally unset in this release.
MALWARE_SCANNER_ENDPOINT=
MALWARE_SCANNER_TOKEN=
DOCUMENT_EXTRACTION_ENDPOINT=
DOCUMENT_EXTRACTION_TOKEN=
EMBEDDING_PROVIDER=ingenium-local-feature-hash
EMBEDDING_MODEL=taxonomy-hash-v1

# Operational contacts are deployment-specific and must be supplied by the institution.
DATA_PROTECTION_CONTACT=
SECURITY_INCIDENT_CONTACT=
