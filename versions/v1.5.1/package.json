{
  "name": "ingenium-plus-v1-5",
  "version": "1.5.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run validate:data && npm run test:logic && npm run test:v151 && npm run typecheck && npm run build && node --test tests/rendered-html.test.mjs",
    "test:logic": "node --test tests/v15-logic.test.mjs",
    "test:v151": "node --test tests/v151-recommendations.test.mjs tests/v151-database.test.mjs tests/v151-security.test.mjs tests/v151-workflows.test.mjs tests/v151-private-bootstrap.test.mjs && node scripts/verify-backup-restore.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit --incremental false",
    "validate:data": "node scripts/validate-data.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:links:live": "node scripts/check-links.mjs --live",
    "db:generate": "drizzle-kit generate",
    "db:seed:generate": "node scripts/generate-v151-seed.mjs",
    "recommendations:evaluate": "node scripts/evaluate-recommendations.mjs"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "cytoscape": "^3.34.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.28.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.56.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.0",
    "wrangler": "4.135.0"
  },
  "overrides": {
    "image-size": "2.0.4"
  },
  "type": "module"
}
