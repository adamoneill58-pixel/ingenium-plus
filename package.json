{
  "name": "ingenium-plus",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "INGENIUM_HOSTING_TARGET=vercel PUBLIC_CATALOGUE_MODE=release-snapshot WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "INGENIUM_HOSTING_TARGET=vercel PUBLIC_CATALOGUE_MODE=release-snapshot NITRO_PRESET=vercel vite build --config vite.vercel.config.ts",
    "start": "INGENIUM_HOSTING_TARGET=vercel PUBLIC_CATALOGUE_MODE=release-snapshot node .output/server/index.mjs",
    "test": "npm run validate:data && npm run test:logic && npm run test:v151 && npm run test:v2 && npm run typecheck && npm run build && npm run test:vercel",
    "test:logic": "node --test tests/v15-logic.test.mjs",
    "test:v151": "node --test tests/v151-recommendations.test.mjs tests/v151-database.test.mjs tests/v151-security.test.mjs tests/v151-workflows.test.mjs tests/v151-private-bootstrap.test.mjs && node scripts/verify-backup-restore.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit --incremental false",
    "validate:data": "node scripts/validate-data.mjs && node scripts/validate-v2-sources.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:links:live": "node scripts/check-links.mjs --live",
    "db:generate": "drizzle-kit generate",
    "db:seed:generate": "node scripts/generate-v151-seed.mjs",
    "recommendations:evaluate": "node scripts/evaluate-recommendations.mjs",
    "test:v2": "node --test tests/v2-pilot.test.mjs tests/v2-connected-campus.test.mjs",
    "data:import": "node scripts/import-dataset.mjs",
    "cloud:configure": "node scripts/configure-cloud.mjs",
    "build:node": "INGENIUM_HOSTING_TARGET=vercel PUBLIC_CATALOGUE_MODE=release-snapshot NITRO_PRESET=node-server vite build --config vite.vercel.config.ts",
    "build:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "deploy:preview": "npm test && node scripts/deploy-vercel.mjs preview",
    "deploy": "npm test && node scripts/deploy-vercel.mjs production",
    "test:vercel": "INGENIUM_TEST_RUNTIME=vercel node --test tests/rendered-html.test.mjs tests/vercel-deployment.test.mjs",
    "test:sites": "npm run validate:data && npm run test:logic && npm run test:v151 && npm run test:v2 && npm run typecheck && npm run build:sites && node --test tests/rendered-html.test.mjs",
    "vercel:link": "npx --yes vercel@64.5.0 link --project prj_Bt35vZQgu3c2mQTXmbamVcSagRF9 --scope team_nByRqHzrSBIGl1ifMzNt7wtb --yes"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "cytoscape": "^3.34.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.28.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.56.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "nitro": "3.0.260903-beta",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.0",
    "wrangler": "4.135.0"
  },
  "overrides": {
    "image-size": "2.0.4"
  },
  "type": "module"
}
